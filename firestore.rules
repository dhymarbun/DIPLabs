rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAsisten() {
      return isSignedIn() && getUserData().role == 'asisten';
    }

    function isPraktikan() {
      return isSignedIn() && getUserData().role == 'praktikan';
    }

    // users/{uid}
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAsisten());
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'praktikan'
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.nim is string
        && request.resource.data.className is string
        && request.resource.data.nim.matches('^[0-9]{8,12}$')
        && getAfter(/databases/$(database)/documents/nims/$(request.resource.data.nim)).data.uid == uid;
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.nim == resource.data.nim
        && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    match /nims/{nim} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && nim.matches('^[0-9]{8,12}$');
      allow update, delete: if false;
    }

    // classes/{classId}
    match /classes/{classId} {
      allow read: if isSignedIn() && (isAsisten() ||
        (resource.data.assistantIds is list && request.auth.uid in resource.data.assistantIds));
      allow create, update, delete: if isAsisten();
    }

    // participants/{participantDocId} ({classId}_{studentId})
    match /participants/{participantDocId} {
      allow read: if isAsisten();
      allow create, update, delete: if isAsisten();
    }

    // sessions/{sessionId}
    match /sessions/{sessionId} {
      allow read: if isSignedIn() && (isAsisten() ||
        (resource.data.participantIds is list && request.auth.uid in resource.data.participantIds));
      allow create, update, delete: if isAsisten()
        && request.resource.data.assistantId == request.auth.uid;
    }

    // attendance/{attendanceDocId} ({sessionId}_{studentId})
    match /attendance/{attendanceDocId} {
      allow read: if isSignedIn() && (
        (isPraktikan() && resource.data.studentId == request.auth.uid) ||
        (isAsisten() && get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.assistantId == request.auth.uid)
      );
      allow create: if isPraktikan()
        && request.resource.data.studentId == request.auth.uid
        && attendanceDocId == (request.resource.data.sessionId + '_' + request.auth.uid)
        && request.resource.data.assistantId == get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.assistantId
        && request.auth.uid in get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.participantIds
        && !exists(/databases/$(database)/documents/attendance/$(attendanceDocId))
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.status == 'open';
      allow update, delete: if false;
    }

    // permissionRequests/{requestId}
    match /permissionRequests/{requestId} {
      allow read: if isSignedIn() && (
        (isAsisten() && resource.data.assistantId == request.auth.uid) ||
        resource.data.studentId == request.auth.uid
      );
      allow create: if isPraktikan()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.assistantId == get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.assistantId
        && request.resource.data.status == 'pending'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0;
      allow update: if isAsisten()
        && resource.data.assistantId == request.auth.uid
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.reason == resource.data.reason;
      allow delete: if isAsisten();
    }

    // laboratories/{labId}
    match /laboratories/{labId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAsisten();
    }

    // notifications/{notificationId}
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.recipientIds;
      allow create: if isAsisten();
      allow update, delete: if false;
    }
  }
}
